		workflow
		{

		schedule
		{
			daily_job_status_cleanup as "Daily Job Status Cleanup"
			{
				type =  schedule
					status = inactive
				start = "2024-05-26 15:53:12"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch all job openings that are not yet closed
										activeJobs = job_opening[job_status == "Active" && application_deadline < today];
										// Iterate through each job and update its status to Closed
										for each  job in activeJobs
										{
											update job
											[
												job_status="Closed"
											];
										}
										// Send notification email to HR about closed jobs
										if(activeJobs.count() > 0)
										{
											jobList = "";
											for each  job in activeJobs
											{
												jobTitle = job.job_title;
												deadline = job.application_deadline;
												jobList = jobList.concat(jobTitle.concat(" (Deadline: ").concat(toString(deadline,"dd-MMM-yyyy")).concat(")\n"));
											}
											sendmail
											[
												from :zoho.adminuserid
												to :zoho.loginuserid
												subject :"Job Openings Closed Automatically"
												message :"The following job openings have been closed as the application deadline has passed:\n\n".concat(jobList)
											]
										}
					)
					}
				}
			}
		}


