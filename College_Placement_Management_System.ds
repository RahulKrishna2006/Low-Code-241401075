	reports
	{
		list application_record_Report
		{
			displayName = "All Application Records"
			show all rows from application_record    
			(
				student as "Student"
				job_opening as "Job Opening"
				application_date as "Application Date"
				application_status as "Application Status"
				application_reference as "Application Reference"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (application_status == "Applied")
				fields = [application_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (application_status == "Rejected")
				fields = [application_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (application_status == "Shortlisted")
				fields = [application_status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban application_record_by_application_status
		{
			displayName = "Application Statuses"
			show all rows from application_record    
			(
				student as "Student"
				job_opening as "Job Opening"
				application_date as "Application Date"
				application_status as "Application Status"
				application_reference as "Application Reference"
			)
			options
			(
	 			display field = application_status
	 		)
		}
		list job_opening_Report
		{
			displayName = "Job Opening Report"
			show all rows from job_opening    
			(
				job_title as "Job Title"
				company as "Company"
				job_description as "Job Description"
				application_deadline as "Application Deadline"
				hiring_drive_date as "Hiring Drive Date"
				job_status as "Job Status"
				job_identifier as "Job Identifier"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (job_status == "Active")
				fields = [job_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (job_status == "Draft")
				fields = [job_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
			)
		}
		kanban job_opening_by_job_status
		{
			displayName = "Job Statuses"
			show all rows from job_opening    
			(
				job_title as "Job Title"
				company as "Company"
				job_description as "Job Description"
				application_deadline as "Application Deadline"
				hiring_drive_date as "Hiring Drive Date"
				job_status as "Job Status"
				job_identifier as "Job Identifier"
			)
			options
			(
	 			display field = job_status
	 		)
		}
		list student_profile_Report
		{
			displayName = "All Student Profiles"
			show all rows from student_profile    
			(
				student_name  as "Student Name"
				roll_number as "Roll Number"
				department as "Department"
				cgpa as "CGPA"
				backlog_count as "Backlog Count"
				resume_url as "Resume URL"
				email as "Email"
				phone_number as "Phone Number"
				placement_status as "Placement Status"
				eligible_departments as "Eligible Departments"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (department == "Civil")
				fields = [department]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (department == "Computer Science")
				fields = [department]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (department == "Electronics")
				fields = [department]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
				"New Formatting4"
				{
				condition = (department == "Management")
				fields = [department]
				format = "color:#ffffff;background-color:#3598db;"
				}
			)
		}
		kanban student_profile_by_department
		{
			displayName = "Departments"
			show all rows from student_profile    
			(
				student_name  as "Student Name"
				roll_number as "Roll Number"
				department as "Department"
				cgpa as "CGPA"
				backlog_count as "Backlog Count"
				resume_url as "Resume URL"
				email as "Email"
				phone_number as "Phone Number"
				placement_status as "Placement Status"
				eligible_departments as "Eligible Departments"
			)
			options
			(
	 			display field = department
	 		)
		}
		list company_profile_Report
		{
			displayName = "All Company Profiles"
			show all rows from company_profile    
			(
				company_name as "Company Name"
				industry as "Industry"
				hr_contact_name  as "HR Contact Name"
				hr_email as "HR Email"
				target_ctc as "Target CTC"
				(
