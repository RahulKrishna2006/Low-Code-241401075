		list interview_round_Report
		{
			displayName = "Interview Round Report"
			show all rows from interview_round    
			(
				application as "Application"
				round_name as "Round Name"
				interviewer_name  as "Interviewer Name"
				interviewer_email as "Interviewer Email"
				scheduled_datetime as "Scheduled Date &amp; Time"
				meeting_link as "Meeting Link"
				feedback_notes as "Feedback Notes"
				round_status as "Round Status"
				round_identifier as "Round Identifier"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (round_status == "Cleared")
				fields = [round_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (round_status == "Eliminated")
				fields = [round_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (round_status == "Scheduled")
				fields = [round_status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban interview_round_by_round_status
		{
			displayName = "Round Statuses"
			show all rows from interview_round    
			(
				application as "Application"
				round_name as "Round Name"
				interviewer_name  as "Interviewer Name"
				interviewer_email as "Interviewer Email"
				scheduled_datetime as "Scheduled Date &amp; Time"
				meeting_link as "Meeting Link"
				feedback_notes as "Feedback Notes"
				round_status as "Round Status"
				round_identifier as "Round Identifier"
			)
			options
			(
	 			display field = round_status
	 		)
		}
