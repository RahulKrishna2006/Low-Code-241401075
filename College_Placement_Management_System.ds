 application "College Placement Management System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form application_record
		{
			displayname = "Application Record"
			success message = "Application Record Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			student
			(
				type = list	
				displayname = "Student"
				values  = student_profile.ID
    			displayformat = [roll_number]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			job_opening
			(
				type = list	
				displayname = "Job Opening"
				values  = job_opening.ID
    			displayformat = [job_identifier]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			application_date
			(
    			type = date
				displayname = "Application Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			application_status
			(
				type = picklist
				displayname = "Application Status"
				values = {"Shortlisted","Rejected","Applied"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			application_reference
			(
    			type = text
				displayname = "Application Reference"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Application Received","Application Under Review","Application Rejected","Application Shortlisted","Application Pending Information","Interview Scheduled","Interview Completed","Interview Rescheduled","Offer Extended","Offer Accepted","Offer Declined","Offer Pending Response","Onboarding Initiated","Offer Withdrawn","Placement Confirmed","Onboarding Paused","Placement Completed"}
			}
		}
		form company_profile
		{
			displayname = "Company Profile"
			success message = "Company Profile Added Successfully"
