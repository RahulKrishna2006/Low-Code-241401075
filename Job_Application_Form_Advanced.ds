 application "Job Application Form Advanced"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Employees
		{
			success message = "Employee Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Employee_Name
			(
    			type = name
				displayname = "Employee Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Department
			(
				type = picklist
				maxchar = 100
				values = {"Engineering","Marketing","Finance","HR"}
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Job_Application_Form
		{
			displayname = "Job Application Form"
			success message = "Job Application Added Successfully"
			Section_A_Personal_Details1
			(
				type = section
				displayname = "Section A — Personal Details"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Candidate_Name
			(
    			type = name
				displayname = "Candidate Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Current_Address
			(
    			type = address
				displayname = "Current Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Contact_Number
			(
    			type = phonenumber
				displayname = "Contact Number"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Section_B_Contact_Online_Presence
			(
				type = section
				displayname = "Section B — Contact & Online Presence"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Email_Address
			(
    			type = email
				displayname = "Email Address"
				maxchar = 80
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			LinkedIn_Portfolio_URL
			(
    			type = text
				displayname = "LinkedIn / Portfolio URL"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Section_C_Job_Experience_Details
			(
				type = section
				displayname = "Section C — Job & Experience Details"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Department_Applied_For
			(
				type = picklist
				displayname = "Department Applied For"
				maxchar = 100
				values = {"Software Development","Marketing","Finance","HR"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			Employment_Type_Preferred
			(
				type = radiobuttons
				displayname = "Employment Type Preferred"
				maxchar = 100
				values = {"Part time","Full time","Internship"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			Years_of_Experience
			(
				type = number
				displayname = "Years of Experience"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Key_Skills
			(
				type = list	
				displayname = "Key Skills"
				values = {"Java","React","SQL","Communication"}
				height = 60px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Available_Joining_Date
			(
    			type = date
				displayname = "Available Joining Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 1   
				width = medium
			)
			Section_D_Interview_Scheduling_Consent
			(
				type = section
				displayname = "Section D — Interview Scheduling & Consent "
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			Preferred_Interview_Time
			(
    			type = time
				displayname = "Preferred Interview Time"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 4
	 			column = 1   
				width = medium
			)
			Cover_Letter
			(
    			type = textarea
				displayname = "Cover Letter"
				height = 100px
	 			row = 4
	 			column = 1   
				width = medium
			)
			I_consent_to_background_verification_if_selected
			(
				type = checkboxes	
				displayname = "I consent to background verification if selected"
				values = {"Checked(Agreed)"}
	 			row = 4
	 			column = 1   
				width = medium
			)
			Section_E_Academic_Referral_Verification
			(
				type = section
				displayname = "Section E — Academic & Referral Verification"
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			Employees
			(
				type = picklist	
				values  = Employees.ID
    			displayformat = [" " + Employee_Name.prefix + " " + Employee_Name.first_name + " " + Employee_Name.last_name + " " + Employee_Name.suffix]
				sortorder = ascending
	 			row = 5
	 			column = 1   
				width = medium
			)
			Candidate_Photo
			(
    			type = image
				displayname = "Candidate Photo"
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 5
	 			column = 1   
				width = medium
			)
			Resume_Upload
			(
    			type = upload file
				displayname = "Resume Upload"
				browse = local_drive
	 			row = 5
	 			column = 1   
				width = medium
			)
			Academic_CGPA
			(
				type = decimal
				displayname = "Academic CGPA"
	 			row = 5
	 			column = 1   
				width = medium
			)
			Section_F_Employment_History_Media_Details
			(
				type = section
				displayname = "Section F — Employment History & Media Details"
				visibility = true
	 			row = 6
	 			column = 0   
				width = medium
			)
			SubForm
			(
				type = grid
				maxrow = 6
				Company_Name
				(
    				type = text
					displayname = "Company Name"
					width = medium
				)
				Designation
				(
    				type = text
					width = medium
				)
				Duration
				(
					type = number
					width = medium
				)
	 			row = 7
	 			column = 1   
				width = medium
			)
			Section
			(
				type = section
	 			row = 8
	 			column = 0   
				width = medium
			)
			Portfolio_GitHub_URL
			(
    			type = url
				displayname = "Portfolio/GitHub URL"
				enable  linkname
	 			row = 8
	 			column = 1   
				width = medium
			)
			Video_Resume
			(
    			type = video
				displayname = "Video Resume"
    			duration=30
	 			row = 8
	 			column = 1   
				width = medium
			)
			Self_Introduction_Audio
			(
     			type = audio
				displayname = "Self Introduction Audio"
    			duration=60
	 			row = 8
	 			column = 1   
				width = medium
			)
			Section_G_Compensation_Relocation
			(
				type = section
				displayname = "Section G — Compensation & Relocation"
				visibility = true
	 			row = 9
	 			column = 0   
				width = medium
			)
			Willing_to_Relocate
			(
    			type = checkbox
				displayname = "Willing to Relocate"
				initial value = false
	 			row = 9
	 			column = 1   
				width = medium
			)
			Current_Annual_CTC
			(
				displayname = "Current Annual CTC"
				type = INR
				format = commadotindian
	 			row = 9
	 			column = 1   
				width = medium
			)
			Expected_Salary_Hike_Percent
			(
    			type = percentage
				displayname = "Expected Salary Hike Percent"
	 			row = 9
	 			column = 1   
				width = medium
			)
			Expected_Annual_CTC
			(
				type = decimal
				displayname = "Expected Annual CTC"
	 			row = 9
	 			column = 1   
				width = medium
    			Formula_Properties
    			(
    						value =  input.Current_Annual_CTC + input.Current_Annual_CTC * input.Expected_Salary_Hike_Percent
    						visibility = false
    			)
			)
			Section_H_Declaration_System_Generated_Values
			(
				type = section
				displayname = "Section H — Declaration & System-Generated Values"
				visibility = true
	 			row = 10
	 			column = 0   
				width = medium
			)
			Company_Culture_Display
			(
    			type = richtext
				displayname = "Company Culture Display"
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 10
	 			column = 1   
				width = medium
			)
			Candidate_Digital_Signature
			(
    			type = signature
				displayname = "Candidate Digital Signature"
	 			row = 10
	 			column = 1   
				width = medium
				personal data = true
			)
			Application_Submitted_On
			(
    			type = datetime
				displayname = "Application Submitted On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 10
	 			column = 1   
				width = medium
			)
			Application_ID
			(
    			type = autonumber
				displayname = "Application ID"
				start index = 1
	 			row = 10
	 			column = 1   
				width = medium
			)
			QR_Code
			(
				type = qrcode
				displayname = "Candidate Tracking QR Code"
				value = "QR image encoding HR\\nAPP-2026-000926"
	 			row = 10
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list All_Job_Applications
		{
			displayName = "All Job Applications"
			show all rows from Job_Application_Form    
			(
				Candidate_Name  as "Candidate Name"
				Current_Address  as "Current Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Contact_Number as "Contact Number"
				(
					displayformat = plainnumber 
				)
				Email_Address as "Email Address"
				LinkedIn_Portfolio_URL as "LinkedIn / Portfolio URL"
				Department_Applied_For as "Department Applied For"
				Employment_Type_Preferred as "Employment Type Preferred"
				Years_of_Experience as "Years of Experience"
				Key_Skills as "Key Skills"
				Available_Joining_Date as "Available Joining Date"
				Preferred_Interview_Time as "Preferred Interview Time"
				Cover_Letter as "Cover Letter"
				I_consent_to_background_verification_if_selected as "I consent to background verification if selected"
				Employees
				Candidate_Photo as "Candidate Photo"
				Resume_Upload as "Resume Upload"
				Academic_CGPA as "Academic CGPA"
				SubForm.Company_Name as "SubForm"
				Willing_to_Relocate as "Willing to Relocate"
				Current_Annual_CTC as "Current Annual CTC"
				Expected_Salary_Hike_Percent as "Expected Salary Hike Percent"
				Expected_Annual_CTC as "Expected Annual CTC"
				Company_Culture_Display as "Company Culture Display"
				Candidate_Digital_Signature as "Candidate Digital Signature"
				Application_Submitted_On as "Application Submitted On"
				Application_ID as "Application ID"
				QR_Code as "Candidate Tracking QR Code"
				Portfolio_GitHub_URL as "Portfolio/GitHub URL"
				Video_Resume as "Video Resume"
				Self_Introduction_Audio as "Self Introduction Audio"
			)
		}
		default list All_Employees
		{
			displayName = "All Employees"
			show all rows from Employees    
			(
				Employee_Name  as "Employee Name"
				Department
			)
		}
	}




	share_settings
	{
			"Read"
			{
				name = "Read"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have read permission for all components\n"
			}
			"Write"
			{
				name = "Write"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have write permission for all components\n"
			}
			"Developer"
			{
				name = "Developer"
				type = Developer
				permissions = {Chat:false, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Developer Profile\n"
			}
			"Administrator"
			{
				name = "Administrator"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have all the permissions.\n"
			}
			"Customer"
			{
				name = "Customer"
				type = Customer_Portal
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This is the default profile having only add and view permission.\n"
			}
			roles
			{
				"CEO"
				{
					description = "User belonging to this role can access data of all other users."
				}
			}
	}

	customize
	{
		icon
		{
			text = "JAF"
			background color = "theme"
			foreground color = "#ffffff"
		}
	}

	web
	{
		forms
		{
			form Employees
			{
				label placement = left
			}
			form Job_Application_Form
			{
				label placement = left
			}
		}
		reports
		{
			report All_Job_Applications
			{
				quickview
				(
					layout
					(
						displaylayout = "classic"
						datablock1
						(
							fields
							(
								Candidate_Name as "Candidate Name"
								Current_Address as "Current Address"
								Contact_Number as "Contact Number"
								Email_Address as "Email Address"
