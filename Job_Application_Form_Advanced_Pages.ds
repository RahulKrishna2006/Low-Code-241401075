 application "Job Application Form Advanced Pages"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Employees
		{
			success message = "Employee Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Employee_Name
			(
    			type = name
				displayname = "Employee Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Department
			(
				type = picklist
				maxchar = 100
				values = {"Engineering","Marketing","Finance","HR"}
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Job_Application_Form
		{
			displayname = "Job Application Form"
			success message = "Job Application Added Successfully"
			Section_A_Personal_Details1
			(
				type = section
				displayname = "Section A — Personal Details"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Candidate_Name
			(
    			type = name
				displayname = "Candidate Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Current_Address
			(
    			type = address
				displayname = "Current Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Contact_Number
			(
    			type = phonenumber
				displayname = "Contact Number"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Section_B_Contact_Online_Presence
			(
				type = section
				displayname = "Section B — Contact & Online Presence"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Email_Address
			(
    			type = email
				displayname = "Email Address"
				maxchar = 80
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			LinkedIn_Portfolio_URL
			(
    			type = text
				displayname = "LinkedIn / Portfolio URL"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Section_C_Job_Experience_Details
			(
				type = section
				displayname = "Section C — Job & Experience Details"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Department_Applied_For
			(
				type = picklist
				displayname = "Department Applied For"
				maxchar = 100
				values = {"Software Development","Marketing","Finance","HR"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			Employment_Type_Preferred
			(
				type = radiobuttons
				displayname = "Employment Type Preferred"
				maxchar = 100
				values = {"Part time","Full time","Internship"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			Years_of_Experience
			(
				type = number
				displayname = "Years of Experience"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Key_Skills
			(
				type = list	
				displayname = "Key Skills"
				values = {"Java","React","SQL","Communication"}
				height = 60px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Available_Joining_Date
			(
    			type = date
				displayname = "Available Joining Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 1   
				width = medium
			)
			Section_D_Interview_Scheduling_Consent
			(
				type = section
				displayname = "Section D — Interview Scheduling & Consent "
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			Preferred_Interview_Time
			(
    			type = time
				displayname = "Preferred Interview Time"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 4
	 			column = 1   
				width = medium
			)
			Cover_Letter
			(
    			type = textarea
				displayname = "Cover Letter"
				height = 100px
	 			row = 4
	 			column = 1   
				width = medium
			)
			I_consent_to_background_verification_if_selected
			(
				type = checkboxes	
				displayname = "I consent to background verification if selected"
				values = {"Checked(Agreed)"}
	 			row = 4
	 			column = 1   
				width = medium
			)
			Section_E_Academic_Referral_Verification
			(
				type = section
				displayname = "Section E — Academic & Referral Verification"
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			Employees
			(
				type = picklist	
				values  = Employees.ID
    			displayformat = [" " + Employee_Name.prefix + " " + Employee_Name.first_name + " " + Employee_Name.last_name + " " + Employee_Name.suffix]
				sortorder = ascending
	 			row = 5
	 			column = 1   
				width = medium
			)
			Candidate_Photo
			(
    			type = image
				displayname = "Candidate Photo"
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 5
	 			column = 1   
				width = medium
			)
			Resume_Upload
			(
    			type = upload file
				displayname = "Resume Upload"
				browse = local_drive
	 			row = 5
	 			column = 1   
				width = medium
			)
			Academic_CGPA
			(
				type = decimal
				displayname = "Academic CGPA"
	 			row = 5
	 			column = 1   
				width = medium
			)
			Section_F_Employment_History_Media_Details
			(
				type = section
				displayname = "Section F — Employment History & Media Details"
				visibility = true
	 			row = 6
	 			column = 0   
				width = medium
			)
			SubForm
			(
				type = grid
				maxrow = 6
				Company_Name
				(
    				type = text
					displayname = "Company Name"
					width = medium
				)
				Designation
				(
    				type = text
					width = medium
				)
				Duration
				(
					type = number
					width = medium
				)
	 			row = 7
	 			column = 1   
				width = medium
			)
			Section
			(
				type = section
	 			row = 8
	 			column = 0   
				width = medium
			)
			Portfolio_GitHub_URL
			(
    			type = url
				displayname = "Portfolio/GitHub URL"
				enable  linkname
	 			row = 8
	 			column = 1   
				width = medium
			)
			Video_Resume
			(
    			type = video
				displayname = "Video Resume"
    			duration=30
	 			row = 8
	 			column = 1   
				width = medium
			)
			Self_Introduction_Audio
			(
     			type = audio
				displayname = "Self Introduction Audio"
    			duration=60
	 			row = 8
	 			column = 1   
				width = medium
			)
			Section_G_Compensation_Relocation
			(
				type = section
				displayname = "Section G — Compensation & Relocation"
				visibility = true
	 			row = 9
	 			column = 0   
				width = medium
			)
			Willing_to_Relocate
			(
    			type = checkbox
				displayname = "Willing to Relocate"
				initial value = false
	 			row = 9
	 			column = 1   
				width = medium
			)
			Current_Annual_CTC
			(
				displayname = "Current Annual CTC"
				type = INR
				format = commadotindian
	 			row = 9
	 			column = 1   
				width = medium
			)
			Expected_Salary_Hike_Percent
			(
    			type = percentage
				displayname = "Expected Salary Hike Percent"
	 			row = 9
	 			column = 1   
				width = medium
			)
			Expected_Annual_CTC
			(
				type = decimal
				displayname = "Expected Annual CTC"
	 			row = 9
	 			column = 1   
				width = medium
    			Formula_Properties
    			(
    						value =  input.Current_Annual_CTC + input.Current_Annual_CTC * input.Expected_Salary_Hike_Percent
    						visibility = false
    			)
			)
			Section_H_Declaration_System_Generated_Values
			(
				type = section
				displayname = "Section H — Declaration & System-Generated Values"
				visibility = true
	 			row = 10
	 			column = 0   
				width = medium
			)
			Company_Culture_Display
			(
    			type = richtext
				displayname = "Company Culture Display"
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 10
	 			column = 1   
				width = medium
			)
			Candidate_Digital_Signature
			(
    			type = signature
				displayname = "Candidate Digital Signature"
	 			row = 10
	 			column = 1   
				width = medium
				personal data = true
			)
			Application_Submitted_On
			(
    			type = datetime
				displayname = "Application Submitted On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 10
	 			column = 1   
				width = medium
			)
			Application_ID
			(
    			type = autonumber
				displayname = "Application ID"
				start index = 1
	 			row = 10
	 			column = 1   
				width = medium
			)
			QR_Code
			(
				type = qrcode
				displayname = "Candidate Tracking QR Code"
				value = "QR image encoding HR\\nAPP-2026-000926"
	 			row = 10
	 			column = 1   
				width = medium
			)
			Application_Status
			(
				type = picklist
				displayname = "Application Status"
				maxchar = 100
				values = {"Applied","Screening","Interview","Offer","Rejected"}
	 			row = 10
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list All_Job_Applications
		{
			displayName = "All Job Applications"
			show all rows from Job_Application_Form    
			(
				Candidate_Name  as "Candidate Name"
				Current_Address  as "Current Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Contact_Number as "Contact Number"
				(
					displayformat = plainnumber 
				)
				Email_Address as "Email Address"
				LinkedIn_Portfolio_URL as "LinkedIn / Portfolio URL"
				Department_Applied_For as "Department Applied For"
				Employment_Type_Preferred as "Employment Type Preferred"
				Years_of_Experience as "Years of Experience"
				Key_Skills as "Key Skills"
				Available_Joining_Date as "Available Joining Date"
				Preferred_Interview_Time as "Preferred Interview Time"
				Cover_Letter as "Cover Letter"
				I_consent_to_background_verification_if_selected as "I consent to background verification if selected"
				Employees
				Candidate_Photo as "Candidate Photo"
				Resume_Upload as "Resume Upload"
				Academic_CGPA as "Academic CGPA"
				SubForm.Company_Name as "SubForm"
				Willing_to_Relocate as "Willing to Relocate"
				Current_Annual_CTC as "Current Annual CTC"
				Expected_Salary_Hike_Percent as "Expected Salary Hike Percent"
				Expected_Annual_CTC as "Expected Annual CTC"
				Company_Culture_Display as "Company Culture Display"
				Candidate_Digital_Signature as "Candidate Digital Signature"
				Application_Submitted_On as "Application Submitted On"
				Application_ID as "Application ID"
				QR_Code as "Candidate Tracking QR Code"
				Portfolio_GitHub_URL as "Portfolio/GitHub URL"
				Video_Resume as "Video Resume"
				Self_Introduction_Audio as "Self Introduction Audio"
				Application_Status as "Application Status"
			)
		}
		default list All_Employees
		{
			displayName = "All Employees"
			show all rows from Employees    
			(
				Employee_Name  as "Employee Name"
				Department
			)
		}
	}
	pages
	{
		page Job_Application_Page(string Video_Resume)
		{
			displayname = "Job Application Page"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Command_Center_Main_Panel'\n \n\t\n\ttitle = 'Section 1 \u2014 Overview Strip'\n\t\n\t\ttitleColor = '#222326'\n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#FF4C2F'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = '385'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'New employees this month'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='50%'\n   \t>\n\t<gauge \n\telementName='Quarterly_Hiring_Target_Gauge'\n\n\tcolor = '#000000'\n\tsize = '20px'\n\tfontFamily = 'default' \n\tbgColor = '#FFFFFF'\n\ttheme = '#FF7B19'\n\tdisplayType = 'actual'\n\ttype = '4'\n\tfilledColor = '#FF7B19'\n\tnonFilledColor = '#F5F5F5'\n\tvalue = 'thisapp.Job_Application_Form.ID.count'\n\t\tcriteria = 'Application_Status == &quot;Offer&quot;'\n>\n<maximumvalue size=\"15px\" color=\"#7F7F7F\" value=\"20\" \n/>\n</gauge>\n</column><column\n   \t\t width='50%'\n   \t>\n\t<chart \n\telementName='Department_Applications_Chart_Widget'\n\n\ttype = 'Bar'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Job_Application_Form'\n\txfield = 'Department_Applied_For'\n\tyfields = 'count:Application_ID'\n/>\n\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<search \n\telementName='Candidate_Search_Bar'\n\tpaddingTop = '40px'\n\tpaddingLeft = '80px'\n\tpaddingRight = '80px'\n\tpaddingBottom = '40px'\n\tbgtype = 'none'\n\tbgColor = '#FFFFFF'\n\n\tshape = 'flat'\n\tresultComponent = 'report'\n\tlinkName = 'All_Job_Applications'\n\ttarget = 'new-window'\n\tcriteriaString = 'Candidate_Name.first_name.contains(input.searchString) &amp;&amp; Candidate_Name.last_name.contains(input.searchString) &amp;&amp; Email_Address.contains(input.searchString) &amp;&amp; Application_ID == input.searchString'\n\tfontFamily = 'default'\n\tappLinkName = 'thisapp'\n\tstyle = '2'\n\tplaceholder = 'Enter value'\n\n>\n<searchbar color=\"#000000\" bgColor=\"#FFFFFF\" fontSize=\"15px\"\n/><searchbutton color=\"#FFFFFF\" bgColor=\"#0072F4\" \nfontSize=\"15px\"  /></search>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel'\n \n\t\n\ttitle = 'Section 2 \u2014 Processing Workspace'\n\t\n\t\ttitleColor = '#222326'\n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = 'theme'\n\tsize = '15px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#5051F9'\n    borderWidth = '0px'\n\n\t  value = 'Send Interview Reminder'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<button \n\t\tmargin = '0px'\n\tpaddingTop = '12px'\n\tpaddingLeft = '15px'\n\tpaddingRight = '15px'\n\tpaddingBottom = '12px'\n\n\tcolor = '#FFFFFF'\n\tsize = '16px'\n    borderColor = '#FFFFFF'\n    borderWidth = '0px'\n\ttext ='Candidate_Application_Report'\n\t\tbgColor = 'theme'\n\t\tcornerRadius = '3px' \n/>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<board\n    \n\tbgColor = '#FFFFFF'\n        bgColorType = 'solid'\n\tpadding = '0px'\nelementName='Application_Status_Board'\n    layoutType = 'grid'\n        items = '1'\n    appLinkName = 'thisapp'\n    formLinkName = 'Job_Application_Form'\n    rankBy = 'ID'\n    rankOrder = 'highestToLowest'\n    rankAggregate = 'count'\n    limit = '3'\n    groupBy = 'Application_Status'\n    criteriaString = 'Candidate_Name.first_name.contains(&quot;&quot;) &amp;&amp; Candidate_Name.last_name.contains(&quot;&quot;) &amp;&amp; Department_Applied_For.contains(&quot;&quot;)'\n>\n<boardHeader>\n    <pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpaddingTop = '14px'\n\tpaddingLeft = '15px'\n\tpaddingRight = '15px'\n\tpaddingBottom = '14px'\n\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#000000'\n\tsize = '17px'\n\tbold = 'true' \n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#000000'\n    borderWidth = '0px'\n\n\t  value = 'Application Status'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</boardHeader>\n<boardLayout\n                paddingRight = '15px'\n                paddingBottom = '14px'\n                paddingLeft = '15px'\n                paddingTop = '2px'\n                itemGap = '10px'\n>\n    <pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpaddingLeft = '20px'\n\tpaddingRight = '20px'\n\n    borderColor = '#F2F2F2'\n    borderWidth = '1px'\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n    \tcornerRadius = '12px'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpaddingTop = '10px'\n\tpaddingBottom = '10px'\n\n\t\twidth = '70%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#000000'\n\tsize = '19px'\n\tbold = 'true' \n\ttype = 'boardData'\n\n\n    lineHeight = '26'\n    numOfLines = '1'\n\n\n\n\n\n\t  value = 'rank'\n>\n</text>\n\n</pc><pc \n\t\n>\n\t<image  \n\t\tmarginLeft = '20px'\n\n\tcolor = '#000000'\n\tbgColor = '#F7F7FB'\n\twidth = '36px'\n\theight = '36px'\n\ttype = 'icon'\n\tvalue = 'education-books-46'\n\tsize = '20px'\n\tcornerRadius = '18px'\n\ticonType = 'outline'\n/>\n</pc><pc \n\t\n>\n\t<text \n\n\tmarginLeft = '15px'\n\tcolor = '#000000'\n\tsize = '16px'\n\ttype = 'boardData'\n\n\n    lineHeight = '22'\n    numOfLines = '1'\n\n\n\n\n\n\t  value = 'groupedField'\n>\n</text>\n\n</pc>\n</pr>\n</pc><pc \n\t\tpaddingTop = '10px'\n\tpaddingBottom = '10px'\n\n\t\twidth = '30%'\n\t\thAlign = 'right'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = 'theme'\n\tsize = '17px'\n\tbold = 'true' \n\ttype = 'boardData'\n\n\n    lineHeight = '23'\n    numOfLines = '1'\n\n\n\n\n\n\t  value = 'rankAggregate'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</boardLayout>\n</board>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Full_Applications_Report'\n\n\t\n\ttitle = 'Section 3 \u2014 Detailed Data'\n\t\n\t\ttitleColor = '#222326'\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'All_Job_Applications'\n\t\n\t\tiszreport = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet' elementName='Interview_Evaluation_Criteria_Snippet'\n bgColor=\"#FFFFFF\" \n\t\n\ttitle = 'Section 4 \u2014 Reference &amp; Quick Actions (Sidebar)'\n\t\n\t\ttitleColor = '#222326'\n>\n\t<![CDATA[htmlpage html_snippet()\ncontent\n&lt;%{\n\t%&gt;\n&lt;div style=&quot;background:#f4f6f9; padding:12px; border-radius:6px; border-left:4px solid #1976d2;&quot;&gt;\n  &lt;h4 style=&quot;margin:0 0 8px 0;&quot;&gt;Interview Evaluation Rubric&lt;/h4&gt;\n  &lt;p style=&quot;font-size:12px; margin:4px 0;&quot;&gt;1. &lt;b&gt;Technical Competence&lt;/b&gt; (1-5): Core skill assessment&lt;/p&gt;\n  &lt;p style=&quot;font-size:12px; margin:4px 0;&quot;&gt;2. &lt;b&gt;Problem Solving&lt;/b&gt; (1-5): Scenario breakdown &amp; logic&lt;/p&gt;\n  &lt;p style=&quot;font-size:12px; margin:4px 0;&quot;&gt;3. &lt;b&gt;Communication&lt;/b&gt; (1-5): Clarity and team fit&lt;/p&gt;\n  &lt;small style=&quot;color:#666;&quot;&gt;Note: Score &amp;ge; 12 required to recommend Offer stage.&lt;/small&gt;\n  &lt;/div&gt;\n&lt;%\n\n}%&gt;]]>\n</dsp>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<viewer\n\telementName='Resume and Video Resume Viewer'\n\ntype = 'AR'\n     heightType = 'auto'\n    directInput = '${Video_Resume}'\n/>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<form \n\telementName='Quick Referral Intake Form'\n\n\tappLinkName = 'thisapp'\n\tlinkName = 'Job_Application_Form'\n\theightType = 'auto'\n\turlType = 'none'\n\tzc_Header = 'false'\n/> \n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<widgets elementName='Interviewer_And_OpenPositions_Widgets' importedTemplate='true'/>\n</column>\n</row>\n</layout>\n</zml>"
		}
	}


		 functions
		 {
			 Deluge
			 {
				 void Send_Interview_Reminder()
                 {
                 	// Filter by status first to test connection
                 	upcomingCandidates = Job_Application_Form[Application_Status == "Interview"];
                 	for each  candidate in upcomingCandidates
                 	{
                 		sendmail
                 		[
                 			from :zoho.adminuserid
                 			to :candidate.Email_Address
                 			subject :"Interview Reminder: Scheduled Within 24 Hours"
                 			message :"Dear Candidate, this is a reminder for your upcoming interview."
                 		]
                 	}
                 }
			 }
		 }


