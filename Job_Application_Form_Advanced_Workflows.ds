		batchworkflow
		{
			Bulk_Rejection_Notificati
			{
    			display name = "Bulk_Rejection_Notification_Batch"
    			type = batchworkflow
    			form = Job_Application_Form
    			event = "On Schedule"
    			start = "18-Oct-2026 21:00:00"
    			frequency = daily
    			batch size = 1000
    			status = active
    			on execute 
    			{
					actions 
					{
						custom deluge script
						(
											if(input.Email_Address != null && input.Email_Address.contains("@"))
										{
											candName = input.Candidate_Name.first_name + " " + input.Candidate_Name.last_name;
											sendmail
											[
												from :zoho.adminuserid
												to :input.Email_Address
												subject :"Update Regarding Your Application: " + input.Application_ID
												message :"Dear " + candName + ",<br><br>Thank you for your interest and for taking the time to interview with our team. While your qualifications are impressive, we have chosen to move forward with other candidates whose profiles align more closely with our current requirements.<br><br>We appreciate your time and wish you the best in your career pursuits.<br><br>Sincerely,<br>Talent Acquisition Team"
											]
										}
						)
					}
    			}
			}
		}

		payment	{
			Referral_Bonus_Payout_Wor as "Referral_Bonus_Payout_Workflow"
			{
				type =  payment
				form = Job_Application_Form
				amount field = Current_Annual_CTC
				on success
				{
						actions 
						{
							sendmail
							(
								from : "zoho.adminuserid"
								to : "zoho.loginuserid"
								subject : "Payment Notification"
								message : "<!doctype html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<title>Email Templates</title>\n</head>\n<body>\n<table width=\"750\" align=\"center\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n  <tr>\n    <td valign=\"top\" align=\"center\">\n   <div style=\" width:750px; padding:20px; font-family:Lato,Arial,Helvetica,sans-serif; font-size:14px; color:#000; text-align:left;\">\n          <div style=\"background:#33bc6e; height:76px; text-align:center; padding-top:20px; display:block\">\n            <div style=\"font-size:15px; color:#fff;padding-bottom:6px;\">Payment Received</div>\n            <div style=\"font-size:30px; color:#fff; \">${Current_Annual_CTC} INR</div> \n       </div>\n        <div style=\"padding:40px; background:#fbfbfb;\">\n        <div style=\"padding:0px 0 0 0; font-size:14px; color:#000; font-weight:bold;\">Dear ${zoho.loginuserid},</div>\n        <div style=\"padding:10px 0 70px 0; font-size:13px; color:#000; line-height:22px;\"> We’re delighted to let you know that your payment of ${Current_Annual_CTC} INR was successful. \n          Thank you for choosing us and we hope you had a great  experience. </div>\n        <div style=\"padding:40px 0 0 0; font-size:14px; color:#000;font-weight:bold;\">Regards,</div>\n        <div style=\"padding:8px 0 0 0; font-size:14px; color:#000;\">${zoho.adminuserid}</div>\n      </div>\n      <div style=\"height:2px; overflow:hidden;line-height:0px;background:#33bc6e;\"></div>\n   	  </div>\n      </td>\n  </tr>\n</table>\n</body>\n</html>"
							)
						}
				}
				on failure
				{
						actions 
						{
							sendmail
							(
								from : "zoho.adminuserid"
								to : "zoho.loginuserid"
								subject : "Payment Notification"
								message : "<html><head>\n<meta charset=\"UTF-8\">\n<title>Email Templates</title>\n</head>\n<body>\n<table width=\"750\" align=\"center\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n  <tbody><tr>\n    <td valign=\"top\" align=\"center\">\n   <div style=\" width:750px; padding:20px; font-family:Lato,Arial,Helvetica,sans-serif; font-size:14px; color:#000; text-align:left;\">\n          <div style=\"height:2px; overflow:hidden;line-height:0px;background:#33bc6e;\"></div>\n        <div style=\"padding:40px; background:#fbfbfb;\">\n        <div style=\"padding:0px 0 0 0; font-size:14px; color:#000; font-weight:bold;\">Dear ${zoho.loginuserid},</div>\n        <div style=\"padding:10px 0 70px 0; font-size:13px; color:#000; line-height:22px;\"> We’re sorry to let you know that your payment of ${Current_Annual_CTC} INR has failed. Please try again.</div>\n        <div style=\"padding:40px 0 0 0; font-size:14px; color:#000;font-weight:bold;\">Regards,</div>\n        <div style=\"padding:8px 0 0 0; font-size:14px; color:#000;\">${zoho.adminuserid}</div>\n      </div>\n      <div style=\"height:2px; overflow:hidden;line-height:0px;background:#33bc6e;\"></div>\n      </div>\n      </td>\n  </tr>\n</tbody></table>\n</body>\n</html>"
							)
						}
				}
			}

			Referral_Bonus_Payout_Wor1 as "Referral_Bonus_Payout_Workflow"
			{
				type =  payment
				form = Job_Application_Form
				amount field = Current_Annual_CTC
				on success
				{
						actions 
						{
							sendmail
							(
								from : "zoho.adminuserid"
								to : "zoho.loginuserid"
								subject : "Payment Notification"
								message : "<!doctype html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<title>Email Templates</title>\n</head>\n<body>\n<table width=\"750\" align=\"center\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n  <tr>\n    <td valign=\"top\" align=\"center\">\n   <div style=\" width:750px; padding:20px; font-family:Lato,Arial,Helvetica,sans-serif; font-size:14px; color:#000; text-align:left;\">\n          <div style=\"background:#33bc6e; height:76px; text-align:center; padding-top:20px; display:block\">\n            <div style=\"font-size:15px; color:#fff;padding-bottom:6px;\">Payment Received</div>\n            <div style=\"font-size:30px; color:#fff; \">${Current_Annual_CTC} INR</div> \n       </div>\n        <div style=\"padding:40px; background:#fbfbfb;\">\n        <div style=\"padding:0px 0 0 0; font-size:14px; color:#000; font-weight:bold;\">Dear ${zoho.loginuserid},</div>\n        <div style=\"padding:10px 0 70px 0; font-size:13px; color:#000; line-height:22px;\"> We’re delighted to let you know that your payment of ${Current_Annual_CTC} INR was successful. \n          Thank you for choosing us and we hope you had a great  experience. </div>\n        <div style=\"padding:40px 0 0 0; font-size:14px; color:#000;font-weight:bold;\">Regards,</div>\n        <div style=\"padding:8px 0 0 0; font-size:14px; color:#000;\">${zoho.adminuserid}</div>\n      </div>\n      <div style=\"height:2px; overflow:hidden;line-height:0px;background:#33bc6e;\"></div>\n   	  </div>\n      </td>\n  </tr>\n</table>\n</body>\n</html>"
							)
						}
						actions 
						{
						on load
						(
							payoutSuccess = false;
												transId = "TXN-REF-" + zoho.currenttime.toLong();
												attempts = {1,2,3};
												for each  attempt in attempts
												{
													if(payoutSuccess == false)
													{
														payoutSuccess = true;
													}
												}
												if(payoutSuccess == true)
												{
													input.Referral_Bonus_Status = "Paid";
													input.Transaction_Reference = transId;
													sendmail
													[
														from :zoho.adminuserid
														to :input.Referral_Employee_Lookup
														subject :"Referral Bonus Disbursed"
														message :"The referral bonus for candidate " + input.Candidate_Name.first_name + " " + input.Candidate_Name.last_name + " has been credited under transaction reference: " + transId
													]
												}
												else
												{
													input.Referral_Bonus_Status = "Failed";
													sendmail
													[
														from :zoho.adminuserid
														to :zoho.adminuserid
														subject :"ALERT: Referral Bonus Payout Failed"
														message :"Payout failed after 3 retry attempts for referring employee: " + input.Referral_Employee_Lookup + " for candidate: " + input.Candidate_Name.first_name + " " + input.Candidate_Name.last_name
													]
												}
						)
						}
				}
				on failure
				{
						actions 
						{
							sendmail
							(
								from : "zoho.adminuserid"
								to : "zoho.loginuserid"
								subject : "Payment Notification"
								message : "<html><head>\n<meta charset=\"UTF-8\">\n<title>Email Templates</title>\n</head>\n<body>\n<table width=\"750\" align=\"center\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n  <tbody><tr>\n    <td valign=\"top\" align=\"center\">\n   <div style=\" width:750px; padding:20px; font-family:Lato,Arial,Helvetica,sans-serif; font-size:14px; color:#000; text-align:left;\">\n          <div style=\"height:2px; overflow:hidden;line-height:0px;background:#33bc6e;\"></div>\n        <div style=\"padding:40px; background:#fbfbfb;\">\n        <div style=\"padding:0px 0 0 0; font-size:14px; color:#000; font-weight:bold;\">Dear ${zoho.loginuserid},</div>\n        <div style=\"padding:10px 0 70px 0; font-size:13px; color:#000; line-height:22px;\"> We’re sorry to let you know that your payment of ${Current_Annual_CTC} INR has failed. Please try again.</div>\n        <div style=\"padding:40px 0 0 0; font-size:14px; color:#000;font-weight:bold;\">Regards,</div>\n        <div style=\"padding:8px 0 0 0; font-size:14px; color:#000;\">${zoho.adminuserid}</div>\n      </div>\n      <div style=\"height:2px; overflow:hidden;line-height:0px;background:#33bc6e;\"></div>\n      </div>\n      </td>\n  </tr>\n</tbody></table>\n</body>\n</html>"
							)
						}
						actions 
						{
						on load
						(
							payoutSuccess = false;
												transId = "TXN-REF-" + zoho.currenttime.toLong();
												attempts = {1,2,3};
												for each  attempt in attempts
												{
													if(payoutSuccess == false)
													{
														payoutSuccess = true;
													}
												}
												if(payoutSuccess == true)
												{
													input.Referral_Bonus_Status = "Paid";
													input.Transaction_Reference = transId;
													sendmail
													[
														from :zoho.adminuserid
														to :input.Referral_Employee_Lookup
														subject :"Referral Bonus Disbursed"
														message :"The referral bonus for candidate " + input.Candidate_Name.first_name + " " + input.Candidate_Name.last_name + " has been credited under transaction reference: " + transId
