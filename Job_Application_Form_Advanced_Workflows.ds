		 functions
		 {
			 Deluge
			 {
				 void Generate_Offer_Letter_Function(string Application_ID)
                 {
                 	for each  candidateRec in Job_Application_Form[ID == Application_ID]
                 	{
                 		if(candidateRec.Candidate_Name != null && candidateRec.Expected_Annual_CTC != null)
                 		{
                 			candName = candidateRec.Candidate_Name.first_name + " " + candidateRec.Candidate_Name.last_name;
                 			candEmail = candidateRec.Email_Address;
                 			joiningDate = zoho.currentdate.addDay(15);
                 			offeredCTC = candidateRec.Expected_Annual_CTC;
                 			sendmail
                 			[
                 				from :zoho.adminuserid
                 				to :candEmail
                 				subject :"Official Offer of Employment: " + candidateRec.Application_ID
                 				message :"Dear " + candName + ",<br><br>Congratulations! We are pleased to extend an offer for employment.<br><br><b>Application ID:</b> " + candidateRec.Application_ID + "<br><b>Annual CTC Offered:</b> Rs. " + offeredCTC + "<br><b>Tentative Joining Date:</b> " + joiningDate + "<br><br>Please review and sign the formal acceptance.<br><br>Best regards,<br>Talent Acquisition Team"
                 			]
                 			candidateRec.Application_Status="Offer";
                 		}
                 	}
                 }
			 }
		 }


		workflow
		{
		form
		{
			On_Application_Submit_Wor as "On_Application_Submit_Workflow"
			{
				type =  form
				form = Job_Application_Form

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Email_Address != null && input.Email_Address.contains("@"))
										{
											candName = input.Candidate_Name.first_name + " " + input.Candidate_Name.last_name;
											interviewTimeStr = ifnull(input.Preferred_Interview_Time.toString(),"To be scheduled");
											sendmail
											[
												from :zoho.adminuserid
												to :input.Email_Address
												subject :"Application Received: " + input.Department_Applied_For + " Role"
												message :"Dear " + candName + ",<br><br>Thank you for applying for the <b>" + input.Department_Applied_For + "</b> position (" + input.Employment_Type_Preferred + ").<br><br>We have successfully received your application along with your details:<br><ul><li><b>Experience:</b> " + input.Years_of_Experience + " years</li><li><b>Earliest Joining Date:</b> " + input.Available_Joining_Date + "</li><li><b>Preferred Interview Time:</b> " + interviewTimeStr + "</li></ul>Our recruitment team will review your profile and reach out to schedule an interview.<br><br>Best regards,<br>Talent Acquisition Team"
											]
										}
										fullName = input.Candidate_Name.first_name + " " + input.Candidate_Name.last_name;
										sendmail
										[
											from :zoho.adminuserid
											to :zoho.adminuserid
											subject :"New Application: " + fullName + " (" + input.Department_Applied_For + ")"
											message :"A new candidate has applied.<br><br><b>Name:</b> " + fullName + "<br><b>Email:</b> " + input.Email_Address + "<br><b>Phone:</b> " + input.Contact_Number + "<br><b>Department:</b> " + input.Department_Applied_For + "<br><b>Key Skills:</b> " + input.Key_Skills + "<br><br>Please review in Candidate_Application_Report."
										]
						)
					}
				}

			}
			OnEdit_Recalculate_CTC_Wo as "OnEdit_Recalculate_CTC_Workflow"
			{
				type =  form
				form = Job_Application_Form

				record event = on edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Current_Annual_CTC != null && input.Expected_Salary_Hike_Percent != null)
										{
											hikeDecimal = input.Expected_Salary_Hike_Percent / 100.0;
											input.Expected_Annual_CTC1 = input.Current_Annual_CTC + input.Current_Annual_CTC * hikeDecimal;
										}
						)
					}
				}

			}
		}

		schedule
		{
			Daily_Interview_Reminder_ as "Daily_Interview_Reminder_Schedule"
			{
				type =  schedule
				start = "2026-10-18 21:00:00"
				frequency = daily
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						startTomorrow = zoho.currentdate.addDay(1).toString("yyyy-MM-dd") + " 00:00:00";
										endTomorrow = zoho.currentdate.addDay(1).toString("yyyy-MM-dd") + " 23:59:59";
										interviewCandidates = Job_Application_Form[Application_Status == "Interview" && Interview_Date_Time >= startTomorrow.toDateTime() && Interview_Date_Time <= endTomorrow.toDateTime()];
										for each  candidate in interviewCandidates
										{
											if(candidate.Email_Address != null && candidate.Email_Address.contains("@"))
											{
												candName = candidate.Candidate_Name.first_name + " " + candidate.Candidate_Name.last_name;
												modeStr = ifnull(candidate.Interview_Mode,"Virtual");
												roundStr = ifnull(candidate.Interview_Round_Details,"Technical Discussion");
												prepNotes = ifnull(candidate.Preparation_Notes,"Please ensure a quiet environment and keep your resume handy.");
												interviewTimeStr = candidate.Interview_Date_Time.toString();
												sendmail
												[
													from :zoho.adminuserid
													to :candidate.Email_Address
													subject :"Interview Reminder: Scheduled for Tomorrow"
													message :"Dear " + candName + ",<br><br>This is a reminder that your interview is scheduled for tomorrow on <b>" + interviewTimeStr + "</b>.<br><br><b>Interview Mode:</b> " + modeStr + "<br><b>Round Details:</b> " + roundStr + "<br><b>Preparation Notes:</b> " + prepNotes + "<br><br>Best regards,<br>Talent Acquisition Team"
												]
											}
										}
					)
					}
				}
			}
		}

		approval
		{
			Job_Offer_Approval as "Job_Offer_Approval"
			{
				type =  approval
				form = Job_Application_Form
				display fields = [Candidate_Name,Current_Address,Contact_Number,Email_Address,LinkedIn_Portfolio_URL,Department_Applied_For,Employment_Type_Preferred]
				on start
				{
					actions 
					{
					on load
					(
						for each  candidateRec in Job_Application_Form[ID == Application_ID]
										{
											if(candidateRec.Candidate_Name != null && candidateRec.Expected_Annual_CTC != null)
											{
												candName = candidateRec.Candidate_Name.first_name + " " + candidateRec.Candidate_Name.last_name;
												candEmail = candidateRec.Email_Address;
												joiningDate = zoho.currentdate.addDay(15);
												offeredCTC = candidateRec.Expected_Annual_CTC;
												sendmail
												[
													from :zoho.adminuserid
													to :candEmail
													subject :"Official Offer of Employment: " + candidateRec.Application_ID
													message :"Dear " + candName + ",<br><br>Congratulations! We are delighted to extend an offer for employment.<br><br><b>Role/Application ID:</b> " + candidateRec.Application_ID + "<br><b>Annual CTC Offered:</b> Rs. " + offeredCTC + "<br><b>Tentative Joining Date:</b> " + joiningDate + "<br><br>Please sign and return the formal acceptance.<br><br>Best regards,<br>Talent Acquisition Team"
												]
												candidateRec.Application_Status="Offer";
											}
										}
					)
					}
				}
				on level 1
				{
					on approve 
					{
						actions 
						{
							sendmail
							(
								from : zoho.loginuserid
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been approved."
							)
						}
						actions 
						{
						on load
						(
							for each  candidateRec in Job_Application_Form[ID == Application_ID]
												{
													if(candidateRec.Candidate_Name != null && candidateRec.Expected_Annual_CTC != null)
													{
														candName = candidateRec.Candidate_Name.first_name + " " + candidateRec.Candidate_Name.last_name;
														candEmail = candidateRec.Email_Address;
														joiningDate = zoho.currentdate.addDay(15);
														offeredCTC = candidateRec.Expected_Annual_CTC;
														sendmail
														[
															from :zoho.adminuserid
															to :candEmail
															subject :"Official Offer of Employment: " + candidateRec.Application_ID
															message :"Dear " + candName + ",<br><br>Congratulations! We are delighted to extend an offer for employment.<br><br>Role/Application ID: " + candidateRec.Application_ID + "<br>Annual CTC Offered: Rs. " + offeredCTC + "<br>Tentative Joining Date: " + joiningDate + "<br><br>Please sign and return the formal acceptance.<br><br>Best regards,<br>Talent Acquisition Team"
														]
														candidateRec.Application_Status="Offer";
													}
												}
						)
						}
					}
					on reject
					{

						actions 
						{
							sendmail
							(
								from : zoho.loginuserid
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been rejected."
							)
						}
						actions 
						{
						on load
						(
							for each  candidateRec in Job_Application_Form[ID == Application_ID]
												{
													if(candidateRec.Candidate_Name != null && candidateRec.Expected_Annual_CTC != null)
													{
														candName = candidateRec.Candidate_Name.first_name + " " + candidateRec.Candidate_Name.last_name;
														candEmail = candidateRec.Email_Address;
														joiningDate = zoho.currentdate.addDay(15);
														offeredCTC = candidateRec.Expected_Annual_CTC;
														sendmail
														[
															from :zoho.adminuserid
															to :candEmail
															subject :"Official Offer of Employment: " + candidateRec.Application_ID
															message :"Dear " + candName + ",<br><br>Congratulations! We are delighted to extend an offer for employment.<br><br>Role/Application ID: " + candidateRec.Application_ID + "<br>Annual CTC Offered: Rs. " + offeredCTC + "<br>Tentative Joining Date: " + joiningDate + "<br><br>Please sign and return the formal acceptance.<br><br>Best regards,<br>Talent Acquisition Team"
														]
														candidateRec.Application_Status="Offer";
													}
												}
						)
						}
					}
				}
			}
		}

